<Page
    x:Class="Cortex.UI.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#88000000">
        <Border MaxWidth="640" MaxHeight="420" VerticalAlignment="Top" Margin="0,80,0,0"
                CornerRadius="8" Background="{ThemeResource CortexNodeFillBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CortexEdgeStrokeBrush}">
            <StackPanel>
                <AutoSuggestBox x:Name="PaletteInput" x:Uid="CommandPalette_Placeholder"
                                Margin="12" QueryIcon="Find"
                                TextChanged="OnQueryChanged" QuerySubmitted="OnQuerySubmitted"/>
                <ListView x:Name="ResultsList" MaxHeight="320" SelectionMode="Single"
                          ItemClick="OnResultClicked" IsItemClickEnabled="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
