<Page
    x:Class="Cortex.UI.Views.ImpactPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Uid="Impact_Title" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border x:Name="ImpactLevelBadge" CornerRadius="4" Padding="8,2">
                <TextBlock x:Name="ImpactLevelText" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8" Padding="0,8,0,0">
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
                <TextBlock x:Uid="Impact_Direct" FontWeight="SemiBold"/>
                <ItemsControl x:Name="DirectList"/>
                <TextBlock x:Uid="Impact_Indirect" FontWeight="SemiBold"/>
                <ItemsControl x:Name="IndirectList"/>
                <TextBlock x:Uid="Impact_Tests" FontWeight="SemiBold"/>
                <ItemsControl x:Name="TestsList"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
