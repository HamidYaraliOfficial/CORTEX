<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        "Windows Default" theme: no CORTEX accent override at all — every control simply
        follows the OS accent color and OS light/dark setting via ThemeResource lookups,
        exactly like a first-party Windows 11 app. Mica/Acrylic backdrops are applied on
        MainWindow itself (see MainWindow.xaml.cs), not here.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CortexCanvasBackgroundBrush" Color="#FFF3F3F3"/>
            <SolidColorBrush x:Key="CortexNodeFillBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="CortexEdgeStrokeBrush" Color="#FF8A8A8A"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CortexCanvasBackgroundBrush" Color="#FF202020"/>
            <SolidColorBrush x:Key="CortexNodeFillBrush" Color="#FF2D2D2D"/>
            <SolidColorBrush x:Key="CortexEdgeStrokeBrush" Color="#FF6E6E6E"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
