<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Forced Dark theme, independent of the OS setting — selected explicitly in Settings. -->
    <SolidColorBrush x:Key="CortexCanvasBackgroundBrush" Color="#FF181818"/>
    <SolidColorBrush x:Key="CortexNodeFillBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="CortexEdgeStrokeBrush" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="CortexTextPrimaryBrush" Color="#FFF2F2F2"/>
</ResourceDictionary>
