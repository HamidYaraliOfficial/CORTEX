<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Custom "Blue" CORTEX accent — overrides the system accent for brand-consistent chrome. -->
    <Color x:Key="CortexAccentColor">#FF0F6CBD</Color>
    <SolidColorBrush x:Key="SystemAccentColor" Color="{StaticResource CortexAccentColor}"/>
    <SolidColorBrush x:Key="CortexAccentBrush" Color="{StaticResource CortexAccentColor}"/>
    <SolidColorBrush x:Key="CortexImpactCriticalBrush" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="CortexCanvasBackgroundBrush" Color="#FF10171F"/>
    <SolidColorBrush x:Key="CortexNodeFillBrush" Color="#FF16222E"/>
    <SolidColorBrush x:Key="CortexEdgeStrokeBrush" Color="#FF5C87A8"/>
</ResourceDictionary>
